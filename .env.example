# FlagPilot real-mode config — copy to .env and fill in. NEVER commit .env.
# Get the values from the Flagsmith Cloud dashboard (free tier):
#   API key: Organisation settings -> API keys
#   Project id: numeric id shown in the project URL / project list
#   Environment key: the environment's key, e.g. the Development environment
FLAGSMITH_API_KEY=
FLAGSMITH_PROJECT_ID=
FLAGSMITH_ENVIRONMENT_KEY=
# Optional overrides (defaults shown):
# FLAGSMITH_API_URL=https://api.flagsmith.com/api/v1
# FLAGSMITH_DASHBOARD_URL=https://app.flagsmith.com
# FLAGSMITH_AUTH_SCHEME=Token
